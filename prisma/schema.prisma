// とびら (Tobira) — 不登校の子ども・親のためのQ&A・交流コミュニティ
// Prisma schema. 開発は SQLite、本番は DATABASE_URL を Postgres 等に差し替え可能。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 利用者（ペンネーム＝匿名前提）。当事者・保護者・支援者など。
/// email/passwordHash が無いユーザーは匿名（cookieのみ）。設定すると本登録アカウント。
model User {
  id           String   @id @default(cuid())
  handle       String   @unique // URL用の一意なハンドル（例: tobira-1234）
  displayName  String // 画面表示名（ニックネーム）
  role         String   @default("member") // member(当事者) | parent(保護者) | supporter(支援者)
  bio          String?
  email        String?  @unique // 本登録時のみ
  passwordHash String? // 本登録時のみ（bcrypt）
  isAdmin      Boolean  @default(false) // モデレーター権限
  createdAt    DateTime @default(now())

  questions   Question[]
  answers     Answer[]
  comments    Comment[]
  votes       Vote[]
  memberships CircleMember[]
  circlePosts CirclePost[]
  sessions    Session[]

  notifications      Notification[] @relation("Recipient") // 受け取った通知
  actedNotifications Notification[] @relation("Actor") // 自分が起こした通知
  reports            Report[]       @relation("Reporter") // 自分がした通報
}

/// ログインセッション（ランダムトークン。cookieにはこのidを保存）
model Session {
  id        String   @id // ランダムトークン
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// レート制限カウンタ（ログイン総当たり・登録スパム対策）
model RateLimit {
  key       String   @id // 例: "login:ip:1.2.3.4" / "login:email:x@x"
  count     Int      @default(0)
  windowEnd DateTime
}

/// 通報（不適切なコンテンツの報告）
model Report {
  id         String    @id @default(cuid())
  reporterId String? // 通報者（匿名可）
  reporter   User?     @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetType String // question | answer | post
  targetId   String
  reason     String // spam | harassment | selfharm | inappropriate | other
  detail     String?
  status     String    @default("open") // open | resolved | dismissed
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([targetType, targetId])
}

/// 通知（自分の質問に回答、投稿に返信 など）
model Notification {
  id        String   @id @default(cuid())
  userId    String // 受け取る人
  user      User     @relation("Recipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String? // 起こした人
  actor     User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  type      String // answer | reply | vote
  message   String
  link      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

/// 質問（SEOの主役。1件=1URL）
model Question {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  circleId  String?
  circle    Circle?  @relation(fields: [circleId], references: [id])
  views     Int      @default(0)
  hidden    Boolean  @default(false) // モデレーションで非表示
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers  Answer[]
  votes    Vote[]
  tags     TagOnQuestion[]
  comments Comment[]
}

/// 回答
model Answer {
  id         String   @id @default(cuid())
  body       String
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  isAccepted Boolean  @default(false)
  hidden     Boolean  @default(false) // モデレーションで非表示
  createdAt  DateTime @default(now())

  votes    Vote[]
  comments Comment[]
}

/// コメント（質問・回答への短い返信）
model Comment {
  id         String    @id @default(cuid())
  body       String
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerId   String?
  answer     Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  hidden     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([questionId])
  @@index([answerId])
}

/// いいね/役に立った（質問・回答どちらにも付けられる）
model Vote {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerId   String?
  answer     Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([userId, questionId])
  @@unique([userId, answerId])
}

/// タグ（検索・回遊用）
model Tag {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  questions TagOnQuestion[]
}

model TagOnQuestion {
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
}

/// サークル（テーマ別の交流コミュニティ。Yayのサークルのイメージ）
model Circle {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  emoji       String   @default("🌱")
  createdAt   DateTime @default(now())

  questions Question[]
  members   CircleMember[]
  posts     CirclePost[]
}

model CircleMember {
  id        String   @id @default(cuid())
  circleId  String
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([circleId, userId])
}

/// サークル内のタイムライン投稿（返信もこのモデル。parentId があれば返信）
model CirclePost {
  id        String   @id @default(cuid())
  body      String
  circleId  String
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  hidden    Boolean  @default(false) // モデレーションで非表示
  createdAt DateTime @default(now())

  // 返信（スレッド）: 親投稿への自己参照
  parentId String?
  parent   CirclePost?  @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  CirclePost[] @relation("PostReplies")
}
