# ── データベース（Postgres） ──────────────────────────────
# ローカル開発・本番ともに Postgres を使います（Neon など）。
# Neon のダッシュボードでコピーした接続文字列を貼り付けます。
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── サイトURL（canonical / OGP / sitemap 用） ─────────────
# 本番の公開URL。Vercelのドメインや独自ドメインを設定します。
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# ── 管理者（モデレーター）にするメール（カンマ区切り） ──────
ADMIN_EMAILS="you@example.com"

# ── AI自動投稿（次ステップで使用）── Claude API キー ────────
# ANTHROPIC_API_KEY="sk-ant-..."
# CRON_SECRET="任意のランダム文字列（cronエンドポイント保護用）"
