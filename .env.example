# ── データベース（Postgres） ──────────────────────────────
# ローカル開発・本番ともに Postgres を使います（Neon など）。
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── サイトURL（canonical / OGP / sitemap 用） ─────────────
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# ── 管理者（モデレーター）にするメール（カンマ区切り） ──────
ADMIN_EMAILS="you@example.com"

# ── AI自動投稿 ──────────────────────────────────────────
# Anthropic APIキー（https://console.anthropic.com で作成）
ANTHROPIC_API_KEY="sk-ant-..."
# cronエンドポイント保護用の任意のランダム文字列
CRON_SECRET="任意のランダム文字列"
# 使用モデル（任意）。既定 claude-sonnet-5。高品質: claude-opus-5 / 安価: claude-haiku-4-5
# AI_MODEL="claude-sonnet-5"
# 1日の生成件数（任意・既定6）
# AI_DAILY_COUNT="6"
