# ── データベース（Postgres） ──────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── サイトURL（canonical / OGP / sitemap / メール内リンク 用） ──
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# ── 管理者（モデレーター）にするメール（カンマ区切り） ──────
ADMIN_EMAILS="you@example.com"

# ── メール送信（Resend）── メール認証・パスワード再設定に使用 ──
# https://resend.com で取得
RESEND_API_KEY="re_..."
# 送信元（独自ドメイン設定前は Resend のテスト用が使えます）
EMAIL_FROM="とびら <onboarding@resend.dev>"
# お問い合わせの届け先（未設定なら ADMIN_EMAILS の先頭に届きます）
CONTACT_EMAIL="you@example.com"

# ── AI自動投稿 ──────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
CRON_SECRET="任意のランダム文字列"
# AI_MODEL="claude-sonnet-5"
# AI_DAILY_COUNT="6"
